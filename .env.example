# 阿里云DashScope OpenAI兼容接口配置
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus

# 阿里云DashScope多模态图片解析API密钥
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 或者使用其他OpenAI兼容接口
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# 服务器配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# 向量数据库配置
CHROMA_PERSIST_DIR=./backend/knowledge_base/chroma_db

# 文件上传限制
MAX_UPLOAD_SIZE=50
ALLOWED_EXTENSIONS=pdf,docx,pptx,png,jpg,jpeg,mp4,avi,mov

# RAG配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
